#	$NetBSD: std.wrap030,v 1.5 2010/09/19 02:09:27 tsutsui Exp $
#
# Options/devices that all wrap030s should have
#

machine wrap030 m68k
include		"conf/std"			# MI standard options
include		"arch/m68k/conf/std.m68k"	# m68k standard options

options 	EXEC_AOUT	# support for exec'ing a.out

options         HZ=1000                         # wrap030 clock runs at 1000Hz
